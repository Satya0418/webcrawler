# Medicine Safety Backend Environment Variables
# Copy this to .env and fill in actual values

# Application
DEBUG=False
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Database
DATABASE_URL=postgresql://medicine_user:password@localhost:5432/medicine_safety
DATABASE_ECHO=False

# Redis
REDIS_URL=redis://localhost:6379/0

# FDA Source
FDA_BASE_URL=https://www.accessdata.fda.gov/scripts/cder/safetylabelingchanges
FDA_CRAWL_TIMEOUT=30
FDA_CRAWL_RETRIES=3
FDA_CRAWL_BACKOFF_FACTOR=0.3

# Cache
CACHE_TTL=3600

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Logging
LOG_LEVEL=INFO
