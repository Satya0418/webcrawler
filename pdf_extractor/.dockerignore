# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments (MUST be ignored to avoid copying host OS binaries)
.venv/
venv/
ENV/
env/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Local databases and runtime WAL/SHM journal files
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite3

# Uploads & Outputs (prevent copying local run data into image)
uploads/*
!uploads/.gitkeep
outputs/*
!outputs/.gitkeep

# Git & Repository metadata
.git/
.gitignore
.github/

# IDE & OS files
.DS_Store
.vscode/
.idea/
*.swp
*~
*.log
