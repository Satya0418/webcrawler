# ==============================================================================
# PDF Section Extractor - Environment Configuration
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=2
DEBUG=False

# Storage & Database Paths
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
SAMPLE_DIR=sample_reports
SQLITE_DB_PATH=extractor.db
# DATABASE_URL=sqlite:///extractor.db

# Optical Character Recognition (OCR) Settings
ENABLE_OCR=True
OCR_LANGUAGE=eng
OCR_CHAR_THRESHOLD=40
TESSERACT_CMD=

# CORS Configuration
ALLOWED_ORIGINS=*
