# ==============================================================================
# PDF Section Extractor & Client API - Environment Configuration
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=2
DEBUG=False

# PostgreSQL Database Configuration (Production Standard)
# In Docker Compose, DATABASE_URL is automatically wired to the postgres service.
# For standalone deployment, uncomment and configure:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pdf_extractor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pdf_extractor
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Automated 30-Minute Background Folder Scanner
# Path where the crawler or automated system places PDF files to be monitored:
PDF_WATCH_DIR=watch_pdfs
SCAN_INTERVAL_MINUTES=30
SCAN_ON_STARTUP=True
DEFAULT_TARGET_SECTION=16

# Client API Security (Optional API Key header authentication)
# If left empty, API requests do not require an API key (useful for local dev).
# If set, clients must pass header: X-API-KEY: your_secret_key_here
API_KEY=

# Storage Paths
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
SAMPLE_DIR=sample_reports

# Optical Character Recognition (OCR) Settings
ENABLE_OCR=True
OCR_LANGUAGE=eng
OCR_CHAR_THRESHOLD=40
TESSERACT_CMD=

# CORS Configuration
ALLOWED_ORIGINS=*
